---
import '../styles/global.css';

import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SplitSection from '../components/SplitSection.astro';
import CardsSection from '../components/CardsSection.astro';
import FinalSection from '../components/FinalSection.astro';
import Footer from '../components/Footer.astro';
---

<html lang="es">

  <head>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="VIBLAS - Soluciones especializadas en vibración, sonido y diagnóstico industrial."
    />


    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />

    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@600;700;800&display=swap"
      rel="stylesheet"
    />


    <title>
      VIBLAS
    </title>

  </head>


  <body>

    <Header />


<main>

  <!-- HERO -->
  <Hero />


  <!-- DIVISIÓN -->
  <div class="diagonal diagonal--right"></div>


  <!-- SECCIÓN 2 -->
  <SplitSection
    number="02"
    eyebrow="LOREM IPSUM"
    title1="Lorem ipsum"
    title2="dolor sit amet."
    buttonText="VER MÁS"
    image="/images/hero-placeholder.jpg"
  />


  <!-- TARJETAS -->
  <CardsSection />


  <!-- DIVISIÓN -->
  <div class="diagonal diagonal--left"></div>


  <!-- SECCIÓN 4 -->
  <SplitSection
    reverse={true}
    number="04"
    eyebrow="LOREM IPSUM"
    title1="Lorem ipsum"
    title2="dolor sit amet."
    buttonText="DESCUBRIR"
    image="/images/hero-placeholder.jpg"
  />


  <!-- CTA -->
  <FinalSection />

</main>

    <Footer />

  </body>

</html>